<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    📌 إعدادات وسياسات مسؤول الجهاز (Device Admin Receiver Configuration)
    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    هذا الملف يحدد صلاحيات وسياسات الأمان التي يطلبها Smart Guardian:
    - force-lock: لقفل شاشة الهاتف فور تلقي أمر من ولي الأمر.
    - watch-login: لمراقبة محاولات تسجيل الدخول الخاطئة.
    - limit-password: لضبط سياسات أمان القفل.
    ============================================================================
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- صلاحية قفل الجهاز فوراً -->
        <force-lock />
        <!-- مراقبة محاولات فتح القفل -->
        <watch-login />
        <!-- ضبط سياسات كلمة المرور وقفل الشاشة -->
        <limit-password />
        <!-- إعادة تعيين كلمة المرور في الحالات الطارئة -->
        <reset-password />
    </uses-policies>
</device-admin>
